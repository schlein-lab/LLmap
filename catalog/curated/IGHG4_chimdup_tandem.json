  "mapping_strategy": {
    "primary": {
      "kmer_size": 25,
      "max_mismatch": 2,
      "include_flanking_bp": 200,
      "include_flanking_anchor": "CH1_start",
      "require_unique_chain": false,
      "note": "k=25 + mm=2 covers all 5 CH1 SNPs; max 2 SNPs co-occur in any 25-mer (closest pair pos 57+69 are 12 bp apart). k=31 also safe. k=51 fails — 3 SNPs in window."
    },
    "fallback_chain": [
      { "stage": 1, "name": "relaxed_mismatch",
        "kmer_size": 25, "max_mismatch": 4,
        "trigger": "primary returns no chain or all chains below confidence floor",
        "rationale": "handles variant-rich CH2/CH3 drift" },
      { "stage": 2, "name": "chain_only",
        "use_extension": false,
        "trigger": "extension diverges (gap-open spike)",
        "rationale": "report best chain without forcing alignment to chimeric region" },
      { "stage": 3, "name": "multi_position",
        "report_all_top_k": true, "k": 4,
        "trigger": "≥2 chains within Δscore tolerance",
        "rationale": "expected for tandem-dup — both copies equally plausible" },
      { "stage": 4, "name": "llm_checkpoint",
        "opt_in_flag": "--llm-fallback",
        "trigger": "user opt-in AND stages 1-3 inconclusive",
        "rationale": "novel haplotype evaluation by LLM against PSV pattern" },
      { "stage": 5, "name": "novel_haplotype_flag",
        "emit_warning": true,
        "rationale": "neither canonical nor dup-fixed PSV pattern matches; flag for curation review" }
    ]
  },

